normalization1 = normalization([0.0, 0.0, 0.0], [256.0, 256.0, 256.0])

model_optimization_flavor(optimization_level=4, compression_level=0)
model_optimization_config(calibration, calibset_size=2048)
performance_param(compiler_optimization_level=max)
post_quantization_optimization(finetune, policy=enabled, dataset_size=2048)
post_quantization_optimization(adaround, policy=enabled, batch_size=8, cache_compression=enabled)

change_output_activation(conv54, sigmoid)
change_output_activation(conv65, sigmoid)
change_output_activation(conv80, sigmoid)
nms_postprocess('/nms_config.json', meta_arch=yolov8, bbox_decoding_only=False)
# path is hardcoded in onnx-2-hef: download_artifacts.py copies the nms artifact to /nms_config.json