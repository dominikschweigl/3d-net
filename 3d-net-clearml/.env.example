# Training configuration
CLEARML_QUEUE="training-multi"              # ClearML queue used by both training and quantization tasks
CLEARML_QUANTIZE_TRAINING_TASK_ID=""        # task-ID of the training run to quantize (required for quantize.py)
END_NODE_NAMES="/model.23/cv2.0/cv2.0.2/Conv /model.23/cv3.0/cv3.0.2/Conv /model.23/cv2.1/cv2.1.2/Conv /model.23/cv3.1/cv3.1.2/Conv /model.23/cv2.2/cv2.2.2/Conv /model.23/cv3.2/cv3.2.2/Conv" # space-separated Hailo parser end nodes; leave empty to use Hailo auto-detection (-y)
FUSION_TYPE="mid"                           # early | mid | midP3 | midCMA3 | midCTF3 | midCTF2 | midCFT3 | late | score - Only used for Yolo11nrgbt.
NMS_CONFIG_PATH="yolo11n_nms_config.json"   # path to the NMS config JSON file (default: yolo11n_nms_config.json)
MODEL_SCRIPT_PATH=""                        # path to the Hailo model script .alls file; leave empty to auto-generate from training params
AUTO_QUANTIZE="false"                   # set to "true" to auto-launch quantization after successful training
EXPORT_ONNX="true"                      # set to "false" to skip ONNX export and use the stock GPT module (e.g. for performance baselines)
OPTIMIZATION_LEVEL="4"                      # quantization optimization level: -100 (none), 0, 1, 2, 3, 4 [default: 4 for production]
COMPRESSION_LEVEL="0"                       # weight compression level: 0–5 (% of weights compressed to 4-bit) [default: 0]
COMPILATION_LEVEL="max"                     # compiler optimization level: 0, 1, 2, "max" [default: "max"]
CALIBRATION_DATA_SIZE="2048"               # number of images used for quantization calibration [recommended >=1024]
PROFILING_DATA_SIZE="100"                  # number of images used for profiling [recommended 64–200]
SKIP_PROFILING="true"                      # set to "true" to skip profiling (faster, but no FPS/latency report)
FIFTYONE_DATASET="rtdod_rgbt"   # visdrone_rgbt | rtdod_rgbt | m3fd_rgbt | 3d_net_rgbt | 3d_net_data_pool_rgbt
FIFTYONE_SNAPSHOT="default"     # FiftyOne snapshot used for quantization calibration
EPOCHS="10"
IMGSZ="640"
BATCH="32"
WORKERS="8"
TEST_SAMPLES="10"               # number of qualitative balanced samples to export

MINIO_ENDPOINT_URL="https://s3.de-west-1.psmanaged.com"
MINIO_REGION="de-west-1"
MINIO_ALIAS="minio"
MINIO_ACCESS_KEY=""
MINIO_SECRET_ACCESS_KEY=""
FIFTYONE_API_URI="https://fiftyone-api.int.svc.bernard-gruppe.com"
FIFTYONE_API_KEY=""
REPO_DEPLOY_TOKEN_USERNAME="x-access-token"
REPO_DEPLOY_TOKEN_PASSWORD=""
CLEARML_LOG_ENVIRONMENT="False"

AZURE_STORAGE_CONNECTION_STRING=""
AZURE_CLEARML_CONNECTION_STRING=""
AZURE_CLEARML_STORAGE_SAS=""
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_STORAGE_ACCOUNT_KEY=""